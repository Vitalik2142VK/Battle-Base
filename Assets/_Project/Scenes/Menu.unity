      objectReference: {fileID: 0}
    - target: {fileID: 1620938908224519726, guid: d6fe62ef7d8719145872baa49daccbf3,
        type: 3}
      propertyPath: _texts._ru._text
      value: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0437\u0434\u0435\u0441\u044C
        \u0431\u0443\u0434\u0435\u0442 \u043D\u0435 \u043E\u043A\u043D\u043E, \u0430
        \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0441\u0446\u0435\u043D\u0430
        \u0441 \u043A\u0430\u0440\u0442\u043E\u0439 \u0438 \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u043D\u044B\u043C\u0438
        \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F\u043C\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 1620938908224519726, guid: d6fe62ef7d8719145872baa49daccbf3,
        type: 3}
      propertyPath: _texts._tr._text
      value: "Belki burada bir pencere olmayacak, ama bir harita ve kazan\u0131lan
