      objectReference: {fileID: 0}
    - target: {fileID: 1620938908224519726, guid: d6fe62ef7d8719145872baa49daccbf3,
        type: 3}
      propertyPath: _texts._tr._text
      value: "Belki burada bir pencere olmayacak, ama bir harita ve kazan\u0131lan
